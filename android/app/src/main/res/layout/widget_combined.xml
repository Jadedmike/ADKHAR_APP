<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_combined_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="12dp"
    android:textDirection="rtl">

    <LinearLayout
        android:id="@+id/combined_prayer_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill_bg_light"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="7dp"
        android:paddingRight="10dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:id="@+id/combined_prayer_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/combined_next_prayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="القادمة: العصر"
                android:textColor="@color/widget_text_primary_light"
                android:textDirection="rtl"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/combined_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_muted_light"
                android:textDirection="rtl"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/combined_countdown_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/combined_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_accent_gold_light"
                android:textDirection="rtl"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/combined_countdown_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="• بعد "
                android:textColor="@color/widget_text_muted_light"
                android:textDirection="rtl"
                android:textSize="11sp" />

            <Chronometer
                android:id="@+id/combined_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_secondary_light"
                android:textDirection="ltr"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/combined_countdown_fallback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_secondary_light"
                android:textDirection="rtl"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/combined_prayer_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="افتح التطبيق لتحديد الموقع"
            android:textColor="@color/widget_text_muted_light"
            android:textDirection="rtl"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/combined_adhkar_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="1"
        android:text="ذكر اليوم"
        android:textColor="@color/widget_accent_gold_light"
        android:textDirection="rtl"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/combined_adhkar_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical|start"
        android:lineSpacingMultiplier="1.18"
        android:maxLines="3"
        android:text="سُبْحَانَ اللَّهِ وَبِحَمْدِهِ، سُبْحَانَ اللَّهِ الْعَظِيمِ."
        android:textColor="@color/widget_text_primary_light"
        android:textDirection="rtl"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>

