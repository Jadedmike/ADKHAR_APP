<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_adhkar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="14dp"
    android:textDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/adhkar_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg_light"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_adhkar_label"
            android:textColor="@color/widget_text_secondary_light"
            android:textDirection="rtl"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adhkar_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:text="ذِكْر"
            android:textColor="@color/widget_accent_gold_light"
            android:textDirection="rtl"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/adhkar_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical|start"
        android:lineSpacingMultiplier="1.2"
        android:maxLines="5"
        android:text="افتح التطبيق لتحديث الأذكار والمواقيت"
        android:textColor="@color/widget_text_primary_light"
        android:textDirection="rtl"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/adhkar_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted_light"
        android:textDirection="rtl"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>

